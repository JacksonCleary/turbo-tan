{
	"$schema": "https://biomejs.dev/schemas/2.3.11/schema.json",
	"extends": ["@repo/config-biome/base"],
	"overrides": [
		{
			"includes": ["**/*.*"],
			"linter": {
				"rules": {
					"complexity": {
						"useLiteralKeys": "off"
					}
				}
			}
		},
		{
			"includes": ["**/*.css"],
			"linter": {
				"rules": {
					"complexity": {
						"noImportantStyles": "off"
					}
				}
			}
		}
	]
}
