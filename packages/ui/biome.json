{
	"$schema": "https://biomejs.dev/schemas/2.3.11/schema.json",
	"extends": "//",
	"overrides": [
		{
			"includes": ["./src/components/**/*.tsx"],
			"linter": {
				"rules": {
					"complexity": {
						"noImportantStyles": "off",
						"useLiteralKeys": "off"
					},
					"style": {
						"useComponentExportOnlyModules": "off"
					}
				}
			}
		}
	],
	"root": false
}
